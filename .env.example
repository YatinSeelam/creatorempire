# creator empire. copy to .env.local for local dev, and set the same names on
# vercel (project -> settings -> environment variables). never commit values.

# --- this deploy ------------------------------------------------------------
# the one workspace this app is. select id from orgs where slug = 'creator-empire'
NEXT_PUBLIC_CE_ORG_ID=
# where this deploy lives. auth redirects and absolute urls are built from it.
NEXT_PUBLIC_SITE_URL=https://app.creatorempire.com


# --- Supabase (this deploy has its own project) -----------------------------
# Both of these are safe in the browser. The publishable key is rate limited
# and every table it can reach is behind row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. This is the service_role key: it BYPASSES row level security
# entirely and can read or write every row in the database. It is read by
# lib/supabase/service.ts and nothing else. Never expose it to the browser and
# never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Stripe ---------------------------------------------------------------
# The WEBHOOK SIGNING SECRET, not an API key. It starts with whsec_ and Stripe
# shows it once, when you add the endpoint under Developers -> Webhooks. A key
# starting sk_ is a secret API KEY and is a different, far more dangerous
# thing — it can move money. It does not belong here and signature
# verification will reject every event if you put one here.
STRIPE_WEBHOOK_SECRET=whsec_...
# the platform's own secret key. checkout sessions, and editor payouts through
# connect. it was never listed here even though two paths already read it.
STRIPE_SECRET_KEY=sk_live_...
# a SECOND webhook endpoint in the dashboard, same url, "connected accounts",
# subscribed to account.updated. it gets its own whsec_. optional: without it an
# editor's stripe account still goes live, it is just noticed when they land
# back on /editors/payouts/stripe rather than the moment stripe verifies them.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# the other payout rail. paypal reaches brazil and nepal, which connect does
# not, and needs nothing from the editor but an email address.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# anything other than exactly "live" means the sandbox, on purpose
PAYPAL_ENV=sandbox

# --- Deal tracking / sync -------------------------------------------------
# Shared secret for /api/cron/refresh. Vercel Cron sends it as
# "Authorization: Bearer $CRON_SECRET" on its own once this exists. With it
# unset the endpoint returns 503 and refuses to run, because an unguarded one
# lets anyone burn the daily api quota. Any long random string works.
CRON_SECRET=

# Free. console.cloud.google.com -> enable "YouTube Data API v3" -> API key.
# 10,000 quota units a day, and a 50-video statistics batch costs 1 unit, so
# youtube tracking never costs money. Wire this up first.
YOUTUBE_API_KEY=

# rapidapi.com, one key for every host. Subscribe the same account to
# "tiktok-api23" and "instagram-api-fast-reliable-data-scraper". Flat monthly
# rate, not per result, which is the whole reason it is here instead of Apify.
# Left unset, tiktok and instagram accounts report "cannot be pulled yet" and
# the typed-in numbers still work.
#
# The transcriber uses the same key and the same two hosts, plus a third:
# "youtube-transcript3", which reads youtube's own published captions for one
# request. Without that subscription youtube links come back with the video and
# no script; tiktok and instagram are unaffected.
RAPIDAPI_KEY=

# --- Transcriber ----------------------------------------------------------
# deepgram.com -> API keys. Speech to text for the transcriber, billed by audio
# minute. Only tiktok and instagram reach it: youtube already publishes its own
# captions, so it never costs a minute. Unset, those two return the video with a
# "transcription is not set up" message and nothing is saved.
DEEPGRAM_API_KEY=

# --- Profile scraper ------------------------------------------------------
# app.scrapecreators.com -> API key. Sent as the "x-api-key" header. This one is
# billed PER CREDIT, and one request is one credit, which is why the tool spends
# them a page at a time on a button press instead of on a schedule. Every call
# is written to public.api_usage_events with the credits_charged the provider
# itself reported, so /usage can say what each person cost.
#
# Pages per credit are wildly uneven and worth knowing before you budget:
# youtube shorts returns ~48, instagram reels ~12, tiktok ~9.
#
# Unset, the tool says it is not set up and no request goes out. It also refuses
# to run when SUPABASE_SECRET_KEY is missing, because that key is the only thing
# that can write the ledger, and credits nobody can account for are worse than
# no scrape at all.
SCRAPECREATORS_API_KEY=

# Apify, for the portfolio clip importer only.
#
# The importer turns a pasted post url into an mp4 in our own bucket, so a
# portfolio plays the clip itself instead of embedding TikTok's or Instagram's
# card. Three actors, run through `run-sync-get-dataset-items` so one request
# starts the run and returns the result:
#   youtube   streamers~youtube-shorts-scraper
#   tiktok    clockworks~tiktok-scraper
#   instagram apify~instagram-scraper
#
# YouTube imports need this. TikTok and Instagram go to SCRAPECREATORS_API_KEY
# first and only fall back here, so those two keep working with it unset.
#
# The token is sent as an Authorization header, never as ?token= in the url,
# so it stays out of logs. Grab it from apify.com > Settings > API & Integrations.
APIFY_TOKEN=

# --- Flow (the ai chat) ---------------------------------------------------
# console.anthropic.com -> API keys. Powers /flow and /api/flow/turn. Unset, the
# route answers "Flow is off on this deploy" and nothing else changes.
ANTHROPIC_API_KEY=

# --- Autoposting ----------------------------------------------------------
# app.upload-post.com -> API key. Server only. This is what logs a creator's
# tiktok / instagram / youtube in so the app can post for them. Unset,
# connecting is off and typed-in handles still track views normally.
UPLOAD_POST_API_KEY=

# --- Account emails (the signup address tool) -----------------------------
# Shared secret between the app and whatever delivers inbound mail. The
# cloudflare worker in email-worker/ sends it as
# "Authorization: Bearer $INBOUND_EMAIL_SECRET" and /api/inbound-email answers
# 401 to everything until it is set. Do not leave it blank in production: an
# open inbound endpoint lets a stranger post themselves a verification code and
# read somebody's account out of the dashboard. Any long random string works.
INBOUND_EMAIL_SECRET=

# The domain every generated address lives under. Defaults to
# accounts.creatorempire.app. Use a SUBDOMAIN: pointing the root domain's MX at a
# catch-all takes over every address already on it. No signup form cares.
ACCOUNT_EMAIL_DOMAIN=accounts.creatorempire.app

# Only if inbound mail comes from Resend instead of the cloudflare worker.
# Resend cannot send a custom header, so a svix signature is the only proof it
# is really them. This is the endpoint's signing secret (whsec_...), shown once
# when you add the webhook. Unset, resend deliveries are rejected and the
# cloudflare path is unaffected.
RESEND_WEBHOOK_SECRET=

# --- Optional -------------------------------------------------------------

# --- Agency custom domains (lib/vercel-domains.ts) --------------------------
# An agency types app.theirbrand.com on /agency/branding; these let the server
# attach it to THIS vercel project so it serves, and read back whether their
# dns points at us. Token: vercel.com -> settings -> tokens, scoped to the
# team. Project and team ids are in .vercel/project.json. Unset, the domain is
# still stored and the page shows the dns records, attaching becomes a hand
# step in the vercel dashboard.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ---- notifications (all optional; every sender no-ops without its key)
# transactional email via resend. no key means no email, nothing else breaks.
RESEND_API_KEY=
# the from address resend is allowed to send as, e.g. "creator empire <hello@creatorempire.app>"
EMAIL_FROM=
# where the cron mails once when the scrape balance crosses under 100 credits
ADMIN_ALERT_EMAIL=
# discord webhook that announces new editing jobs and client sign-offs
DISCORD_JOBS_WEBHOOK_URL=
